        "@modelcontextprotocol/server-puppeteer"
      ]
    },
    "sqlite": {
      "command": "uvx",
      "args": [
        "mcp-server-sqlite",
        "--db-path",
        "https://jdwawncmybyjthqovftk.supabase.co"
      ]
